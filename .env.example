# Copy to .env. If GEMINI_API_KEY is absent here, scripts fall back to my_ai_skills/my_ai_skills/.env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Optional overrides. Defaults: .UNI-COURSEWORK in your work/school OneDrive (OneDriveCommercial), and the vault as
# academic_vault next to this repo.
# ONEDRIVE_COURSEWORK=
# VAULT_PATH=
# Where generated files go (defaults: state\ and out\ in this repo, config\ for unit configs)
# PIPELINE_STATE=
# PIPELINE_OUT=
# PIPELINE_CONFIG=
# The .ps1 runners' Python (default: %USERPROFILE%\.conda\envs\pipeline_academic\python.exe); set it in your shell
# PIPELINE_PYTHON=
# api = Gemini API key (free tier ~20/day) | agy = Antigravity CLI on the AI Pro subscription (~1500/day)
GEMINI_BACKEND=agy
AGY_MODEL=gemini-3.8-flash-medium
# share_vault.py: the export folder (default: the folder holding .peer_export in your OneDrive, else
# SHARED\usyd-course-notes there), and extra regexes that must never be shared (classmates' names), comma-separated.
# Patterns that name you go in config/share.yaml (see config.example/share.yaml).
# SHARE_PATH=
SHARE_BLOCK_PATTERNS=
# Calendars whose events count as busy (comma-separated calendar IDs / emails)
GCAL_BUSY_CALENDARS=primary,you@example.com
# Calendars (name or ID) whose events never count as busy
GCAL_IGNORE_CALENDARS=
